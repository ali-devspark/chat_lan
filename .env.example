# WebRTC TURN Relay Configuration (Required for Cross-Network / Mobile Cellular <-> Wi-Fi calls)
# Option 1: Free Metered Video Account (50 GB free monthly TURN relay - https://www.metered.ca/)
METERED_DOMAIN=your-app-domain.metered.ca
METERED_API_KEY=your-metered-api-key

# Option 2: Custom TURN Server (CoTURN, Cloudflare, Twilio, etc.)
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:443?transport=tcp
# NEXT_PUBLIC_TURN_USERNAME=username
# NEXT_PUBLIC_TURN_CREDENTIAL=password
